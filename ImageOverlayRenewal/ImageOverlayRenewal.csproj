<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net35</TargetFramework>
        <LangVersion>12</LangVersion>
        <Authors>Mbyron26</Authors>
        <Copyright>Copyright © 2022-2026 Mbyron26</Copyright>
        <Version>1.11.0</Version>
        <BuildRevision Condition="'$(Configuration)' == 'Stable'">0</BuildRevision>
        <BuildRevision Condition="'$(Configuration)' == 'Beta'">0</BuildRevision>
        <BuildRevision Condition="'$(Configuration)' == 'Alpha'">2000</BuildRevision>
        <AssemblyVersion>$(Version).$(BuildRevision)</AssemblyVersion>
        <FileVersion>$(Version).$(BuildRevision)</FileVersion>
        <InformationalVersion>$(Version).$(BuildRevision)</InformationalVersion>
        <!-- Steam workshop title, will auto set title from this property. -->
        <Product>Image Overlay Renewal</Product>
        <!-- Steam workshop stable release Id, set to 0 for initial release. -->
        <StableID>2616880500</StableID>
        <!-- Steam workshop beta release Id, set to 0 for initial release. -->
        <BetaID>2671781645</BetaID>
        <!--> Steam workshop visibility, 0: public, 1: friends only, 2: private, 3: unlisted -->
        <Visibility>0</Visibility>
    </PropertyGroup>

    <Import Project="$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Modding\Mod.props"/>
    <Import Project="$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Modding\Mod.targets"/>

    <ItemGroup>
        <None Include="$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Modding\Mod.props" Link="Properties\Mod.props"/>
        <None Include="$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Modding\Mod.targets" Link="Properties\Mod.targets"/>
        <Folder Include="Properties\"/>
        <Reference Include="Newtonsoft.Json" HintPath="$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Modding\Libraries\Newtonsoft.Json.dll"/>
        <Reference Include="CSLModdingFramework.dll" HintPath="$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Modding\Libraries\CSLModdingFramework.dll"/>
        <Reference Include="CSLModdingFramework.ToolPanel.dll" HintPath="$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Modding\Libraries\CSLModdingFramework.ToolPanel.dll"/>
        <PackageReference Include="UnifiedUILib" Version="2.2.12"/>
        <Content Include="Localization\**\*" CopyToOutputDirectory="Always"/>
        <EmbeddedResource Include="UI\Resources\InGameButton.png"/>
        <None Update="Translations.tt">
            <Generator>TextTemplatingFileGenerator</Generator>
            <LastGenOutput>Translations.cs</LastGenOutput>
        </None>
        <Compile Update="Translations.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Translations.tt</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}"/>
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Copy SourceFiles="$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Modding\Libraries\System.Runtime.Serialization.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true"/>
    </Target>

</Project>
